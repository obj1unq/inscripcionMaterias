import example.*

describe "test de universidad" {

  const epl = new Materia()
  const mate1 = new Materia(año=1, creditos=8)
  const obj1 = new Materia(año=1, creditos=8)
  const obj2 = new Materia()
  const obj3 = new Materia()
  const bd = new Materia(año=1, creditos=8)
  const pconc = new Materia()
  const meya = new Materia()
  const tys = new Materia()
  const economia = new Materia()
  const desarrolloLocal = new Materia()
  const lea = new Materia(año=1, creditos=8)
  const ciencias = new Materia(año=1, creditos=8)
  const psicologia = new Materia(año=2, creditos=4)
  const antro = new Materia(año=2, creditos=4)
  const socio = new Materia(año=3, creditos=8)

  const programacion = new Carrera(materias=#{epl, mate1, obj1, obj2, obj3, bd, pconc})
  const tuess = new Carrera(materias=#{meya, tys, economia, desarrolloLocal})
  const to  = new Carrera(materias=#{lea, ciencias,psicologia, antro, socio})

  const alex = new Estudiante()
  const andy = new Estudiante()



  method initialize() {

    obj2.requisito(new Correlativas(materias = #{obj1, mate1}))
    obj3.requisito(new Correlativas(materias =#{obj2,bd}))
    pconc.requisito(new Correlativas(materias =#{obj1,bd}))
    desarrolloLocal.requisito(new Correlativas(materias =#{meya}))

    psicologia.requisito(new AñoCompleto(carrera=to)) //otra opcion es cambiar para que las materias sepan la carrera, pero me lleva refactorizar la manera de construirlas
    antro.requisito(new Creditos(carrera=to, creditosNecesarios=8))
    socio.requisito(new Creditos(carrera=to, creditosNecesarios=10))


    alex.inscribir(programacion)
    alex.inscribir(tuess)

    alex.cursada(mate1, 2)
    alex.cursada(obj1, 10)
    alex.cursada(economia, 6)
    alex.cursada(tys, 8)
    alex.cursada(mate1, 8)
    alex.cursada(bd, 2)

    andy.inscribir(to)
    andy.inscribir(programacion)
    andy.cursada(obj1,10)
    andy.cursada(mate1, 10)


  }
  test "alex carreras" {
      assert.equals(#{programacion, tuess}, alex.carreras())
      assert.that(alex.perteneceASusCarreras(bd))
      assert.notThat(alex.perteneceASusCarreras(psicologia))
      assert.throwsException({alex.inscribir(programacion)})
  }
  test "alex cursadas" {
    assert.throwsException({alex.cursada(mate1, 7)})
    assert.throwsException({alex.cursada(bd, 12)})
    assert.that(alex.aprobada(mate1))
    assert.notThat(alex.aprobada(bd))
    assert.equals(9, alex.promedio(programacion))
    assert.equals(2, alex.cantidadAprobadas(programacion))
    assert.equals(7, alex.promedio(tuess))
    assert.throwsException({ alex.promedio(to) })
    alex.inscribir(to)
    assert.throwsException({ alex.promedio(to) })
    assert.equals(8, alex.promedio())
    assert.equals([2,8], alex.cursadas(mate1).map({cursada => cursada.nota()}))
  }

  test "inscripciones de materias" {
    
    assert.equals(#{epl, obj2, bd}, programacion.materiasInscribibles(alex))
    assert.equals(#{meya}, tuess.materiasInscribibles(alex))
    assert.notThat(alex.puedeInscribirMateria(psicologia))
    assert.throwsException({alex.inscribirMateria(psicologia)})
    assert.notThat(alex.puedeInscribirMateria(economia))
    assert.throwsException({alex.inscribirMateria(economia)})
    assert.notThat(alex.puedeInscribirMateria(desarrolloLocal))
    assert.throwsException({alex.inscribirMateria(desarrolloLocal)})
    alex.inscribirMateria(obj2)
    assert.throwsException({alex.inscribirMateria(obj2)})
    andy.inscribirMateria(obj2)
    assert.equals(#{andy,alex}, obj2.inscriptos())
  }

  test "requisitos de creditos y años" {
    assert.equals(#{lea, ciencias}, to.materiasInscribibles(andy))
    andy.cursada(lea, 10)
    assert.equals(8, andy.creditos(to))
    assert.notThat(andy.añoCompleto(to, 1))

    assert.equals(#{antro, ciencias}, to.materiasInscribibles(andy))
    andy.cursada(antro, 10)
    assert.equals(12, andy.creditos(to))
    assert.notThat(andy.añoCompleto(to, 1))

    assert.equals(#{socio, ciencias}, to.materiasInscribibles(andy))
    andy.cursada(ciencias, 10)
    assert.equals(20, andy.creditos(to))
    assert.that(andy.añoCompleto(to, 1))

    assert.equals(#{psicologia, socio}, to.materiasInscribibles(andy))
    andy.inscribirMateria(psicologia)
    andy.inscribirMateria(socio)

    assert.equals(#{andy}, psicologia.inscriptos())
    assert.equals(#{andy}, socio.inscriptos())

    
  }
}
